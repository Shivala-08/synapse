# ── Synapse environment template ─────────────────────────────────────────────
# Copy to `.env` and fill in values. No real keys are committed to the repo.

# Python path (used by scripts like run_benchmark_now.py)
PYTHONPATH=.

# ── LLM: NVIDIA NIM (OpenAI-compatible) ──────────────────────────────────────
# Up to 10 keys, tried in order with automatic rotation on rate limits.
# Leave all empty to skip NVIDIA and fall back to local Ollama.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=
NVIDIA_API_KEY_6=
NVIDIA_API_KEY_7=
NVIDIA_API_KEY_8=
NVIDIA_API_KEY_9=
NVIDIA_API_KEY_10=

# Alternative: comma-separated key pool (used if the individual keys above are empty)
NVIDIA_NIM_API_KEYS=

# ── LLM: Anthropic (legacy, unused by default) ───────────────────────────────
ANTHROPIC_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Optional: Hugging Face token for the HF Inference API embedding service.
# If unset or unreachable, the embedder falls back to local sentence-transformers.
HF_TOKEN=

# ── Admin security ──────────────────────────────────────────────────────────
# Set to true to require ADMIN_API_KEY for destructive endpoints (production)
# REQUIRE_ADMIN_KEY=false

# ── Feature flags (ablation study) ───────────────────────────────────────────
# USE_RERANKER=true
# USE_HYBRID=true
# USE_GRAPH=true
# USE_SEMANTIC_CACHE=true
