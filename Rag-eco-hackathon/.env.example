# ── Synapse environment template ─────────────────────────────────────────────
# Copy to `.env` and fill in values. No real keys are committed to the repo.
# Every variable Synapse reads is documented below.

# ── Python path (used by scripts like run_benchmark_now.py) ──────────────────
PYTHONPATH=.

# ── Paths ────────────────────────────────────────────────────────────────────
# Workspace root containing the second-brain/ and second-brain-agent/ folders
# alongside this repo. Domain source_paths in domains/*.yaml are resolved
# against this. Defaults to the parent directory of this repo — set it only
# if the layout differs.
#   Required: no    Example: ADHD_CURE_ROOT=/home/me/adhd-cure
ADHD_CURE_ROOT=

# Optional per-domain source path overrides. Takes priority over the value in
# domains/<domain>.yaml (useful for production mounts).
#   Required: no    Example: SECOND_BRAIN_SOURCE_PATH=/data/vault/wiki
#                            EXAM_PREP_SOURCE_PATH=/data/study-materials
SECOND_BRAIN_SOURCE_PATH=
EXAM_PREP_SOURCE_PATH=

# ── LLM: NVIDIA NIM (OpenAI-compatible) ──────────────────────────────────────
# Up to 10 keys, tried in order with automatic rotation on rate limits.
# Leave all empty to skip NVIDIA and fall back to local Ollama.
#   Required: no (falls back to Ollama / Smart Context)
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
NVIDIA_API_KEY_5=
NVIDIA_API_KEY_6=
NVIDIA_API_KEY_7=
NVIDIA_API_KEY_8=
NVIDIA_API_KEY_9=
NVIDIA_API_KEY_10=

# Alternative: comma-separated key pool (used if the individual keys above are empty)
#   Example: NVIDIA_NIM_API_KEYS=nvapi-xxx,nvapi-yyy
NVIDIA_NIM_API_KEYS=

# ── LLM: Anthropic (legacy, unused by default) ───────────────────────────────
#   Required: no
ANTHROPIC_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Optional: Hugging Face token for the HF Inference API embedding service.
# If unset or unreachable, the embedder falls back to local sentence-transformers.
#   Required: no
HF_TOKEN=

# ── Admin security ──────────────────────────────────────────────────────────
# Guards destructive endpoints (/ingest/initialize, /ingest/upload,
# /ingest/re-sync, /benchmark/run, /debug/search) via the X-API-Key header.
#   Required: no in local dev, YES in production
#   Example: ADMIN_API_KEY=change-me
ADMIN_API_KEY=

# When true, refuse to start if ADMIN_API_KEY is empty (production safety).
#   Required: no    Example: REQUIRE_ADMIN_KEY=true
REQUIRE_ADMIN_KEY=false

# Comma-separated allowed CORS origins (empty = allow all without credentials).
#   Required: no    Example: CORS_ORIGINS=https://synapse.example.com,http://localhost:3000
CORS_ORIGINS=

# ── Feature flags (ablation study) ───────────────────────────────────────────
#   Required: no (defaults shown)
USE_RERANKER=true
USE_HYBRID=true
USE_GRAPH=true
USE_SEMANTIC_CACHE=true