# Root-level ignores for adhd-cure workspace
# Subprojects have their own .gitignore (Rag-eco-hackathon/.gitignore, web/.gitignore)

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# Generated/derived data — never commit databases, caches, or vector indexes
data/*.db
data/*.db-journal
data/semantic_cache.json
data/knowledge_graph.json
data/documents.json
data/chroma_db/
data/corpus/uploads/
data/benchmarks/retrieval_log.json

# Static JS (downloaded at build time)
static/js/

# Logs
*.log
backend.log

# Scratch / logs at workspace root
frontend.log
frontend-smoke.log

# OS files
.DS_Store
Thumbs.db

# Generated/scratch docs
*.tmp
*.bak

# IDE
.idea/
.vscode/
*.swp
*.swo

# Env (repo ships with .env.example only)
.env
.env.local

# Generated data (root-level catch)
data/
benchmark-results/

# Agent TUI runtime state
second-brain-agent/.tsbuildinfo
second-brain-agent/state.json
second-brain-agent/dist/

# Second Brain vault — local Obsidian config, generated output, logs
second-brain/.obsidian/
second-brain/output/
second-brain/logs/

# node_modules in any subproject
node_modules/
**/node_modules/
